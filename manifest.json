{
  "manifest_version": 2,
  "name": "Databricks Email-Code Auto Login",
  "version": "0.1.0",
  "description": "Auto-fills the Databricks login email, waits for the code email in Gmail, then fills and submits the code.",

  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "*://*.databricks.com/*",
    "*://*.azuredatabricks.net/*",
    "*://*.gcp.databricks.com/*",
    "*://mail.google.com/*"
  ],

  "background": {
    "scripts": ["config.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.databricks.com/*",
        "*://*.azuredatabricks.net/*",
        "*://*.gcp.databricks.com/*"
      ],
      "js": ["config.js", "content-databricks.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_action": {
    "default_title": "Databricks auto-login",
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "dbx-login@shay.local",
      "strict_min_version": "115.0"
    }
  }
}
