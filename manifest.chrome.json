{
  "manifest_version": 3,
  "name": "Definity Auto Login",
  "version": "0.1.0",
  "description": "Automates logins: Databricks email-code (via Gmail) and the AWS access portal account/role.",

  "permissions": ["tabs", "storage", "scripting"],

  "host_permissions": [
    "*://*.databricks.com/*",
    "*://*.azuredatabricks.net/*",
    "*://*.gcp.databricks.com/*",
    "*://*.awsapps.com/*",
    "*://app.definity.run/*",
    "*://dev.definity.run/*",
    "*://mail.google.com/*"
  ],

  "background": {
    "service_worker": "sw.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.databricks.com/*",
        "*://*.azuredatabricks.net/*",
        "*://*.gcp.databricks.com/*"
      ],
      "js": ["config.js", "content-databricks.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.awsapps.com/*"],
      "js": ["config.js", "content-aws.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://app.definity.run/login*", "*://dev.definity.run/login*"],
      "js": ["config.js", "content-definity.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "Definity auto-login",
    "default_popup": "popup.html"
  }
}
